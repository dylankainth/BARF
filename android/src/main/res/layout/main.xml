<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barf_bg"
    android:fitsSystemWindows="true">

    <!-- ── Header bar ─────────────────────────────────────── -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BARF"
            android:textColor="@color/barf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <!-- Status dots: API · Serial · WASM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API"
            android:textColor="@color/barf_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:layout_marginEnd="4dp"/>
        <View
            android:id="@+id/dotApi"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_green"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERIAL"
            android:textColor="@color/barf_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:layout_marginEnd="4dp"/>
        <View
            android:id="@+id/dotSerial"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_red"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WASM"
            android:textColor="@color/barf_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:layout_marginEnd="4dp"/>
        <View
            android:id="@+id/dotWasm"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_red"/>

    </LinearLayout>

    <!-- ── Camera preview (fills remaining space minus controls) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/cameraview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>

    </FrameLayout>

    <!-- ── Controls card ──────────────────────────────────── -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <!-- ── Action buttons row ─── -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/buttonSwitchCamera"
                style="@style/BARFButton"
                android:text="Switch Camera"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/buttonPair"
                style="@style/BARFButton"
                android:text="Pair Desktop"
                android:layout_marginStart="0dp"/>

        </LinearLayout>

        <!-- ── Divider ─── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/barf_border"
            android:layout_marginBottom="14dp"/>

        <!-- ── Task row ─── -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/BARFLabel"
                android:text="TASK"/>

            <Spinner
                android:id="@+id/spinnerTask"
                style="@style/BARFSpinner"
                android:entries="@array/task_array"/>

        </LinearLayout>

        <!-- ── Model row ─── -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/BARFLabel"
                android:text="MODEL"/>

            <Spinner
                android:id="@+id/spinnerModel"
                style="@style/BARFSpinner"
                android:entries="@array/model_array"/>

        </LinearLayout>

        <!-- ── Engine row ─── -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                style="@style/BARFLabel"
                android:text="ENGINE"/>

            <Spinner
                android:id="@+id/spinnerCPUGPU"
                style="@style/BARFSpinner"
                android:entries="@array/cpugpu_array"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
