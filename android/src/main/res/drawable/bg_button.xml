<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#14161C" android:endColor="#1B1D23"
                android:angle="315" android:type="linear"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/barf_border_subtle"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/barf_btn_start" android:endColor="@color/barf_btn_end"
                android:angle="315" android:type="linear"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/barf_border_subtle"/>
        </shape>
    </item>
</selector>
