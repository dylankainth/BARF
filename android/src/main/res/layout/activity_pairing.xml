<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barf_bg"
    android:keepScreenOn="true">

    <!-- Camera preview fills the screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/pairingPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Corner bracket overlay - subtle scan frame hint -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp">

        <!-- Top-left corner -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="top|start"
            android:background="@color/barf_text_primary"/>
        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:background="@color/barf_text_primary"/>

        <!-- Top-right corner -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="top|end"
            android:background="@color/barf_text_primary"/>
        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:background="@color/barf_text_primary"/>

        <!-- Bottom-left corner -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|start"
            android:background="@color/barf_text_primary"/>
        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:background="@color/barf_text_primary"/>

        <!-- Bottom-right corner -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|end"
            android:background="@color/barf_text_primary"/>
        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:background="@color/barf_text_primary"/>

    </FrameLayout>

    <!-- Bottom status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BARF"
            android:textColor="@color/barf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair with Desktop"
            android:textColor="@color/barf_text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/pairingStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Point camera at QR code shown on the desktop app"
            android:textColor="@color/barf_text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"/>

    </LinearLayout>

    <!-- Header bar (top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/barf_overlay">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BARF"
            android:textColor="@color/barf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR PAIRING"
            android:textColor="@color/barf_text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

</FrameLayout>
